# Configuration facultative de l'application de bureau Relances SMS.
# Emplacement : %APPDATA%\RelancesSMS\config.env  (copier ce fichier et le renommer).
# Sans ce fichier : mode SIMULATION, aucun SMS réel n'est envoyé.
# Protéger ce fichier : il peut contenir l'identifiant secret du fournisseur SMS.

# Fournisseur : simulation (défaut) | twilio | disabled
SMR_SMS_PROVIDER=simulation
# SMR_TWILIO_ACCOUNT_SID=AC...
# SMR_TWILIO_AUTH_TOKEN=...

# Fréquence de vérification des relances (secondes)
SMR_WORKER_POLL_SECONDS=30

# Base de données : par défaut %LOCALAPPDATA%\RelancesSMS\relances.db
# Pour partager les données avec la version serveur, indiquer la base PostgreSQL commune :
# SMR_DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@serveur:5432/sms_reminders
