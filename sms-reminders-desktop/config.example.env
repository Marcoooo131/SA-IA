# Configuration facultative de l'application de bureau Relances SMS.
# Emplacement : %APPDATA%\RelancesSMS\config.env — normalement rempli par l'application
# (Paramètres → Téléphones d'envoi) ; les mots de passe ne vont jamais dans ce fichier.

# Envoi : telephone (défaut : les téléphones de l'entreprise envoient depuis leur SIM) | disabled
SMR_SMS_PROVIDER=telephone
# Téléphone Movers (application SMS Gate, mode « Serveur local »)
# SMR_PHONE_MOVERS_URL=192.168.1.23:8080
# SMR_PHONE_MOVERS_USER=sms
# Téléphone Takeovers
# SMR_PHONE_TAKEOVERS_URL=192.168.1.24:8080
# SMR_PHONE_TAKEOVERS_USER=sms

# Fréquence de vérification des relances (secondes)
SMR_WORKER_POLL_SECONDS=30
