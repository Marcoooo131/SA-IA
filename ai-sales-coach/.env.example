# ============================================================================
# AI SALES COACH — configuration (copier en .env ; NE JAMAIS committer .env)
# ============================================================================

# --- Données ----------------------------------------------------------------
# Dossier des données (base SQLite, audio chiffré, clé locale). Par défaut : data/runtime
# ASC_DATA_DIR=data/runtime
# Base multi-utilisateurs : postgresql+psycopg://user:motdepasse@hote:5432/sales_coach (pip install "psycopg[binary]")
# ASC_DATABASE_URL=

# --- Modèle IA (facultatif) -------------------------------------------------
# none (défaut, 100 % hors ligne) | ollama | openai_compatible | anthropic
ASC_LLM_PROVIDER=none
# Exemples : llama3.1:8b (Ollama) · mistral-nemo (Ollama) · gpt-4o-mini (OpenAI) · claude-sonnet-5-5 (Anthropic)
ASC_LLM_MODEL=
# Ollama : http://localhost:11434 · LM Studio : http://localhost:1234/v1 · OpenAI : https://api.openai.com/v1
ASC_LLM_BASE_URL=
# Clé API (fournisseurs externes uniquement). Ne jamais l'écrire dans le code.
ASC_LLM_API_KEY=
ASC_LLM_TIMEOUT=120
# Garde-fou : tant que false, AUCUNE donnée n'est envoyée à un service externe.
# Passer à true uniquement après validation conformité (RGPD, contrat de sous-traitance).
ASC_ALLOW_EXTERNAL_API=false

# --- Transcription audio (locale) -------------------------------------------
# auto | faster_whisper | openai_whisper | none
ASC_TRANSCRIPTION_BACKEND=auto
# tiny | base | small | medium | large-v3  (small = bon compromis CPU)
ASC_WHISPER_MODEL=small
# cpu | cuda
ASC_WHISPER_DEVICE=cpu
# Jeton Hugging Face pour la diarisation pyannote (optionnel)
# ASC_HF_TOKEN=

# --- Base de connaissances ---------------------------------------------------
# auto (sentence-transformers si installé, sinon lexical) | sentence_transformers | hashing
ASC_EMBEDDING_BACKEND=auto
ASC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# sqlite (défaut) | chroma
ASC_VECTOR_STORE=sqlite
# Adresse de contact pour l'API OpenAlex (« polite pool »), facultative
ASC_OPENALEX_MAILTO=
ASC_HTTP_USER_AGENT=AI-Sales-Coach/1.0 (knowledge importer)

# --- Sécurité & confidentialité ---------------------------------------------
# Clé de chiffrement Fernet. Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si vide : une clé est générée dans <ASC_DATA_DIR>/.encryption.key (à sauvegarder !)
ASC_ENCRYPTION_KEY=
ASC_ANONYMIZE_BY_DEFAULT=true
# Durée de conservation des transcriptions et de l'audio (jours). 0 = illimitée.
ASC_RETENTION_DAYS=90
# false = poste local mono-utilisateur sans écran de connexion (déconseillé en équipe)
ASC_REQUIRE_LOGIN=true
# Jeton de l'API REST (vide = API désactivée)
ASC_API_TOKEN=
