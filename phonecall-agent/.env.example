# Copy to .env (never commit it). In production, inject these from a secret manager
# (Vault, AWS Secrets Manager, Azure Key Vault, Kubernetes secrets...), not from a file.

PCA_ENVIRONMENT=dev                    # dev | test | staging | production
PCA_DATABASE_URL=sqlite:///./phonecall_agent.db
# PCA_DATABASE_URL=postgresql+psycopg://phonecall:CHANGE_ME@localhost:5432/phonecall
PCA_REDIS_URL=redis://localhost:6379/0
PCA_QUEUE_BACKEND=inline               # inline (dev only) | rq
PCA_BUSINESS_CONFIG_PATH=config/business.example.yaml
PCA_PUBLIC_BASE_URL=https://phonecall.example.internal   # exact public URL Twilio calls (signature check)

# --- Twilio (server side only)
PCA_TWILIO_ACCOUNT_SID=
PCA_TWILIO_AUTH_TOKEN=                 # used to verify webhook signatures
PCA_TWILIO_API_KEY_SID=                # recommended for REST calls (restricted API key)
PCA_TWILIO_API_KEY_SECRET=
PCA_TWILIO_ALLOWED_ACCOUNT_SIDS=       # optional: extra sub-accounts allowed
PCA_TWILIO_VALIDATE_SIGNATURE=true
PCA_TWILIO_MEDIA_FORMAT=mp3
PCA_TWILIO_DELETE_RECORDING_AFTER_PROCESSING=false   # only after a validated retention decision

# --- Data protection
PCA_DATA_ENCRYPTION_KEY=               # python -m phonecall_agent.cli gen-key
PCA_AUDIO_TEMP_DIR=./var/audio
PCA_AUDIO_MAX_BYTES=62914560

# --- Providers
PCA_TRANSCRIPTION_PROVIDER=simulated   # simulated (dev/test) | faster_whisper
PCA_WHISPER_MODEL=medium
PCA_GENERATION_PROVIDER=simulated      # simulated (dev/test) | anthropic
PCA_ANTHROPIC_API_KEY=
PCA_ANTHROPIC_MODEL=claude-opus-5-5
PCA_ANTHROPIC_EFFORT=medium
PCA_ANTHROPIC_SERVER_FALLBACK=true

# --- CRM: stays "disabled" until an official, authorised interface is documented and tested
PCA_CRM_CONNECTOR=disabled             # disabled | simulated (dev/test only)
PCA_CRM_AUTO_PUSH_READY=false

# --- Web UI
PCA_SESSION_SECRET=                    # python -c "import secrets; print(secrets.token_urlsafe(48))"
PCA_UI_USERS=                          # login:role:hash;...  (python -m phonecall_agent.cli hash-password)
PCA_COOKIE_SECURE=true                 # false only for local http
PCA_METRICS_TOKEN=                     # bearer token for Prometheus scraping
