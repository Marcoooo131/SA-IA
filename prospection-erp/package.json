{
  "name": "prospection-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prospection commerciale d'un ERP BTP à 15 € HT / mois : ciblage TPE du bâtiment, scoring justifié, messages personnalisés, suivi multicanal, rentabilité et optimisation mensuelle (local-first).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "typescript": "~5.9.0",
    "vitest": "^4.1.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.20.5"
  }
}
