# Configuration de la version de test téléchargeable de Phone Call.
# Modifiable avec le Bloc-notes. Aucun secret ne doit être écrit ici.

# Version de test : capture réelle du son du PC et du micro, transcription locale,
# note SIMULÉE (aucune IA) tant qu'aucune passerelle n'est configurée.
PCD_ENVIRONMENT=test
PCD_AUDIO_BACKEND=wasapi
PCD_RECOGNIZER=whisper
PCD_WHISPER_MODEL=small
PCD_NOTES_CLIENT=simulated

# Pour une vraie note par l'IA : passerelle phonecall-agent de l'entreprise
# (voir docs/CONFIGURATION_CLES.md), puis remplacer la ligne PCD_NOTES_CLIENT ci-dessus :
# PCD_NOTES_CLIENT=gateway
# PCD_GATEWAY_URL=https://adresse-de-la-passerelle

PCD_REQUIRE_CONSENT_CONFIRMATION=true
PCD_HISTORY_ENABLED=false
