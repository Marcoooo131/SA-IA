# Configuration de Phone Call. Modifiable avec le Bloc-notes. Aucun secret ne doit être écrit ici :
# la clé API Claude se saisit dans l'application (bouton « Clé API ») et reste dans le coffre Windows.

# Capture réelle du son du PC et du micro, transcription locale (l'audio ne quitte pas le PC),
# note rédigée par Claude à la fin de l'appel (seule la transcription texte est envoyée).
PCD_ENVIRONMENT=production
PCD_AUDIO_BACKEND=wasapi
PCD_RECOGNIZER=whisper
PCD_WHISPER_MODEL=small
PCD_NOTES_CLIENT=anthropic
PCD_ANTHROPIC_MODEL=claude-opus-5-5
PCD_ANTHROPIC_EFFORT=medium

# Pour passer plus tard par la passerelle de l'entreprise (clé API sur un serveur, voir
# docs/CONFIGURATION_CLES.md), remplacer PCD_NOTES_CLIENT=anthropic par :
# PCD_NOTES_CLIENT=gateway
# PCD_GATEWAY_URL=https://adresse-de-la-passerelle

PCD_REQUIRE_CONSENT_CONFIRMATION=true
PCD_HISTORY_ENABLED=false
