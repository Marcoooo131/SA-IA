# Configuration de Phone Call. Modifiable avec le Bloc-notes. Aucun secret ne doit être écrit ici.

# Capture réelle du son du PC et du micro, transcription sur le PC avec le modèle livré dans le
# dossier models\ (aucun téléchargement, aucun accès à Hugging Face), et compte rendu SANS IA
# dans la template générale Phone Call (phone_call_template.yaml, à côté de l'exe) : aucun coût,
# rien n'est envoyé sur Internet.
PCD_ENVIRONMENT=production
PCD_AUDIO_BACKEND=wasapi
PCD_RECOGNIZER=whisper
PCD_WHISPER_MODEL=small
PCD_NOTES_CLIENT=local

# Votre nom, pour le champ « Agent » (sinon : nom entendu dans l'appel « À confirmer », ou
# « Aucune information notifiée »).
PCD_AGENT_NAME=

# Microsoft 365 Copilot Chat (compte professionnel) : boutons « Préparer pour Copilot » et
# « Coller la réponse de Copilot » sous la note. Gratuit avec la licence Microsoft 365, par
# copier-coller (pas d'accès automatique). Mettre false pour masquer les boutons.
PCD_COPILOT_ENABLED=true
PCD_COPILOT_URL=https://m365.cloud.microsoft/chat
# Longueur au-delà de laquelle un avertissement s'affiche (limite officielle non publiée).
PCD_COPILOT_MAX_CHARS=16000

# Option : note rédigée par Claude (payante, la transcription texte est envoyée à Anthropic).
# Remplacer PCD_NOTES_CLIENT=local par PCD_NOTES_CLIENT=anthropic, puis saisir la clé API dans
# l'application (bouton « Clé API ») ; voir docs/CONFIGURATION_CLES.md.
PCD_ANTHROPIC_MODEL=claude-opus-5-5
PCD_ANTHROPIC_EFFORT=medium

PCD_REQUIRE_CONSENT_CONFIRMATION=true
PCD_HISTORY_ENABLED=false
