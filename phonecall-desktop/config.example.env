# Exemple de configuration du poste (sans secret).
# Copier dans %APPDATA%\PhoneCallDesktop\config.env (ou définir des variables d'environnement PCD_*).
# Le jeton de la passerelle n'est JAMAIS mis ici : voir docs/CONFIGURATION_CLES.md.

PCD_ENVIRONMENT=production            # production | test | dev
PCD_AUDIO_BACKEND=wasapi              # wasapi | test-files (fichiers synthétiques/anonymisés uniquement)

# Transcription locale (l'audio ne quitte pas le poste)
PCD_RECOGNIZER=whisper
PCD_WHISPER_MODEL=small               # base (poste faible) | small (recommandé) | medium (plus précis, plus lent)
PCD_WHISPER_MODEL_DIR=C:\ProgramData\PhoneCallDesktop\models   # modèles déployés par la DSI (pas de téléchargement)
PCD_WHISPER_DEVICE=cpu
PCD_WHISPER_COMPUTE_TYPE=int8
PCD_VOCABULARY=Sector Alarm, télésurveillance, centrale, détecteur, badge, déménagement, résiliation
# Améliorateur de texte : hésitations, bégaiements, vocabulaire métier, numéros de téléphone, typographie
PCD_TEXT_ENHANCER=true
# PCD_TEXT_CORRECTIONS=secteur alarme=>Sector Alarm; centrale d'alarme=>centrale

# Génération de la note : passerelle de l'entreprise (phonecall-agent, POST /api/v1/notes)
PCD_NOTES_CLIENT=gateway
PCD_GATEWAY_URL=https://phonecall-gateway.example.internal
PCD_GATEWAY_TIMEOUT_S=90
# PCD_GATEWAY_CA_BUNDLE=C:\ProgramData\PhoneCallDesktop\ca.pem   # si inspection TLS

# Confidentialité
PCD_REQUIRE_CONSENT_CONFIRMATION=true
PCD_MAX_SESSION_MINUTES=120
PCD_HISTORY_ENABLED=false             # à n'activer qu'avec l'accord du DPO
PCD_HISTORY_RETENTION_DAYS=7
PCD_HISTORY_STORE_TRANSCRIPT=false
