# Copier en .env et compléter. Ne jamais committer le fichier .env.
# Environnement : dev | test | staging | production
SMR_ENVIRONMENT=dev

# Base de données (PostgreSQL obligatoire hors dev/test)
SMR_DATABASE_URL=sqlite:///./sms_reminders.db
# SMR_DATABASE_URL=postgresql+psycopg://sms:<mot_de_passe>@localhost:5432/sms_reminders

# Session web : chaîne aléatoire d'au moins 32 caractères
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SMR_SESSION_SECRET=
SMR_COOKIE_SECURE=false

# Comptes : "login:rôle:hash" séparés par ";" — rôles advisor | supervisor | admin
# Hash : python -m sms_reminders.cli hash-password
SMR_UI_USERS=

# Fournisseur SMS : simulation (aucun envoi réel) | twilio | disabled
SMR_SMS_PROVIDER=simulation
# Identifiants Twilio (uniquement si SMR_SMS_PROVIDER=twilio) — fournis par l'administrateur du compte
SMR_TWILIO_ACCOUNT_SID=
SMR_TWILIO_AUTH_TOKEN=
SMR_TWILIO_VALIDATE_SIGNATURE=true
# URL publique HTTPS de l'application (accusés de livraison). Vide = pas d'accusés.
SMR_PUBLIC_BASE_URL=

# Moteur de planification
SMR_WORKER_POLL_SECONDS=30
SMR_WORKER_LEASE_SECONDS=300

# Import
SMR_IMPORT_MAX_BYTES=5242880
SMR_IMPORT_MAX_ROWS=5000
