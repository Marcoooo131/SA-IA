{
  "name": "movers-audit-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype de démonstration : audit de sécurité 2D/3D et génération de devis pour le service Movers (non officiel).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "exceljs": "^4.4.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "~5.4.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "~0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
