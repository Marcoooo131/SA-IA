{
  "name": "english-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "English Coach : application mobile (PWA) d'apprentissage de l'anglais écrit en 90 jours, avec professeur IA et synchronisation.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "build:artifact": "tsc -b && vite build --config vite.artifact.config.ts && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "lucide-react": "^1.55.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
