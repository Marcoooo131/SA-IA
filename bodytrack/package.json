{
  "name": "bodytrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BODYTRACK : coaching musculation & nutrition (React + TypeScript + Tailwind + Recharts + Supabase), PWA installable, local-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.67.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-is": "~19.2.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
