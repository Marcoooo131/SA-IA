# ── Base de données (PostgreSQL) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace3x"

# ── Application ──
APP_URL="http://localhost:3000"
# Secret de signature (cookies de référence, jetons). 32+ caractères aléatoires.
APP_SECRET="change-me-to-a-long-random-string-0123456789"

# ── Paiement ──
# "stripe" (mode test conseillé : clés sk_test_…) ou "demo" (bac à sable local, aucun argent réel).
PAYMENT_PROVIDER="demo"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── E-mails ──
# Sans SMTP, les e-mails sont conservés dans la table EmailOutbox et visibles dans /admin/emails.
SMTP_URL=""
EMAIL_FROM="MARKETPLACE 3X <no-reply@marketplace3x.local>"

# ── Stockage des images ──
# "local" (public/uploads, développement uniquement). Voir docs/ARCHITECTURE.md pour S3 / Vercel Blob.
STORAGE_DRIVER="local"

# ── Tâches planifiées ──
# Jeton exigé par /api/cron/release-commissions (en-tête Authorization: Bearer …)
CRON_SECRET="change-me"
